# ---------------------------------------------------------------------------
# TORRS thesis project — .gitignore
# ---------------------------------------------------------------------------

# ── User-specified exclusions ───────────────────────────────────────────────
.claude/
Malta/signal_route_copy/

# ── SUMO network dataset and caches (regenerated/large) ─────────────────────
Malta/data/malta.net.xml
Malta/data/malta_cache.pkl
Malta/data/malta_cache_v2.pkl
Malta/data/exp.add.xml
Malta/data/exp_*.rou.xml
Malta/data/exp_*.sumocfg
Malta/data/ild_out.xml
Malta/data/bg_*

# ── TensorFlow model checkpoints (regenerated by training) ─────────────────
# Match checkpoints anywhere in the tree — including backup folders
**/checkpoint
**/checkpoint-*.data-*
**/checkpoint-*.meta
**/checkpoint-*.index

# ── Local backup folders (working copies of large artefacts) ───────────────
Malta/signal_route/_may12_backup/
**/_*_backup/

# ── TensorBoard event logs ─────────────────────────────────────────────────
Malta/signal_route/log/events.out.tfevents.*
Malta/signal_route/log/*.log

# ── SUMO runtime logs and trip output (top-level) ──────────────────────────
sumo_*.log
sumo_errors.txt
*_trip.xml

# ── Training / evaluation run logs ─────────────────────────────────────────
# Regenerable, and huge: the first extended run alone is 227 MB of repeated
# TraCI errors. The results themselves live in the CSVs, which are tracked.
/*.log
Malta/signal_route/eva_log/*.log

# ── Python bytecode / caches ───────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Notebook backups and Jupyter ───────────────────────────────────────────
*.ipynb.broken_bak
*.broken_bak
.ipynb_checkpoints/

# ── Editor / OS noise ──────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Python virtual environments ────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── pip / setuptools ───────────────────────────────────────────────────────
*.egg-info/
build/
dist/
